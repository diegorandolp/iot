{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-1:CUENTA:client/esp32_puerta" },
    { "Effect": "Allow", "Action": "iot:Publish",
      "Resource": ["arn:aws:iot:us-east-1:CUENTA:topic/casa/puerta/eventos",
                   "arn:aws:iot:us-east-1:CUENTA:topic/casa/puerta/estado"] },
    { "Effect": "Allow", "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:us-east-1:CUENTA:topicfilter/casa/puerta/comandos" },
    { "Effect": "Allow", "Action": "iot:Receive",
      "Resource": "arn:aws:iot:us-east-1:CUENTA:topic/casa/puerta/comandos" }
  ]
}
